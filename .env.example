# REVIVE Environment Configuration
# Copy this file to .env and fill in the values.

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# For PostgreSQL (production/development):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/revive
# For SQLite (local testing without PostgreSQL):
DATABASE_URL=sqlite+aiosqlite:///./data/revive_dev.db
DATABASE_ECHO=false

# LLM Provider (required from Agent milestone onward)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-4

# Security
# SECRET_KEY=change-me-in-production
